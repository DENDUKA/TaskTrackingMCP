@inherits LayoutComponentBase
@using TaskTracking.Web.Services
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation
@implements IDisposable

@if (IsPublicPage())
{
    @Body
}
else if (_isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (CurrentUserService.CurrentUser != null)
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">X</span>
</div>

@code {
    private bool _isLoading = true;

    protected override void OnInitialized()
    {
        CurrentUserService.OnCurrentUserChanged += OnUserChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !IsPublicPage())
        {
            await CurrentUserService.Initialize();
            _isLoading = false;

            if (CurrentUserService.CurrentUser == null)
            {
                Navigation.NavigateTo("login");
            }
            else
            {
                StateHasChanged();
            }
        }
    }

    private void OnUserChanged()
    {
        InvokeAsync(() =>
        {
            if (!IsPublicPage() && CurrentUserService.CurrentUser == null)
            {
                Navigation.NavigateTo("login");
            }
            StateHasChanged();
        });
    }

    private bool IsPublicPage()
    {
        var uri = Navigation.Uri;
        return uri.Contains("/login", StringComparison.OrdinalIgnoreCase)
            || uri.Contains("/test-users", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        CurrentUserService.OnCurrentUserChanged -= OnUserChanged;
    }
}
