@using TaskTracking.Web.Components.Shared
@using TaskTracking.Web.Domain.Entities
@using TaskTracking.Web.Models

<div class="card mb-2 task-card" 
     draggable="@Draggable.ToString().ToLower()" 
     @ondragstart="HandleDragStart"
     @onclick="HandleClick">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h6 class="card-title mb-0 flex-grow-1">@Task.Title</h6>
            @if (ShowActions)
            {
                <div class="dropdown">
                    <button class="btn btn-sm btn-link text-muted" type="button" data-bs-toggle="dropdown" @onclick:stopPropagation="true">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#" @onclick="HandleEdit" @onclick:preventDefault><i class="bi bi-pencil me-2"></i>Редактировать</a></li>
                        <li><a class="dropdown-item text-danger" href="#" @onclick="HandleDelete" @onclick:preventDefault><i class="bi bi-trash me-2"></i>Удалить</a></li>
                    </ul>
                </div>
            }
        </div>
        
        @if (!string.IsNullOrEmpty(Task.Description))
        {
            <p class="card-text small text-muted mb-2">@TruncateText(Task.Description, 100)</p>
        }
        
        @if (ShowAssignee && !string.IsNullOrEmpty(AssigneeName))
        {
            <div class="d-flex align-items-center text-muted small">
                <i class="bi bi-person-circle me-1"></i>
                <span>@AssigneeName</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public TaskItem Task { get; set; } = null!;
    [Parameter] public bool Draggable { get; set; } = true;
    [Parameter] public bool ShowActions { get; set; } = true;
    [Parameter] public bool ShowAssignee { get; set; } = true;
    [Parameter] public string? AssigneeName { get; set; }
    [Parameter] public EventCallback<TaskItem> OnClick { get; set; }
    [Parameter] public EventCallback<TaskItem> OnEdit { get; set; }
    [Parameter] public EventCallback<TaskItem> OnDelete { get; set; }
    [Parameter] public EventCallback<TaskItem> OnDragStart { get; set; }

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(Task);
        }
    }

    private async Task HandleEdit()
    {
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync(Task);
        }
    }

    private async Task HandleDelete()
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(Task);
        }
    }

    private async Task HandleDragStart(DragEventArgs e)
    {
        if (Draggable && OnDragStart.HasDelegate)
        {
            await OnDragStart.InvokeAsync(Task);
        }
    }

    private string TruncateText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= maxLength)
            return text;
        
        return text.Substring(0, maxLength) + "...";
    }
}