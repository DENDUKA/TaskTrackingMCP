@using TaskTracking.Web.Components.Shared
@using TaskTracking.Web.Domain.Entities
@using TaskTracking.Web.Models

<div class="col-md-4 mb-4">
    <div class="card h-100 glass-effect">
        <div class="card-header @HeaderClass text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Title</h5>
                <span class="badge @BadgeClass">@TaskCount</span>
            </div>
        </div>
        <div class="card-body p-3 kanban-column" 
             @ondrop="HandleDrop"
             @ondragover:preventDefault="true"
             @ondragover="HandleDragOver"
             @ondragleave="HandleDragLeave">
            
            @if (Tasks != null && Tasks.Any())
            {
                @foreach (var task in Tasks)
                {
                    <TaskCard Task="task" 
                              ShowAssignee="ShowAssignee"
                              AssigneeName="@(ShowAssignee && GetAssigneeName != null ? GetAssigneeName!(task.AssigneeId) : null)"
                              OnClick="HandleTaskClick"
                              OnEdit="HandleTaskEdit"
                              OnDelete="HandleTaskDelete"
                              OnDragStart="HandleTaskDragStart" />
                }
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-1"></i>
                    <p>Нет задач</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string HeaderClass { get; set; } = "bg-secondary";
    [Parameter] public string BadgeClass { get; set; } = "text-secondary";
    [Parameter] public int TaskCount { get; set; } = 0;
    [Parameter] public List<TaskItem> Tasks { get; set; } = new();
    [Parameter] public bool ShowAssignee { get; set; } = true;
    [Parameter] public Func<Guid?, string>? GetAssigneeName { get; set; }
    [Parameter] public EventCallback OnDrop { get; set; }
    [Parameter] public EventCallback<DragEventArgs> OnDragOver { get; set; }
    [Parameter] public EventCallback<DragEventArgs> OnDragLeave { get; set; }
    [Parameter] public EventCallback<TaskItem> OnTaskClick { get; set; }
    [Parameter] public EventCallback<TaskItem> OnTaskEdit { get; set; }
    [Parameter] public EventCallback<TaskItem> OnTaskDelete { get; set; }
    [Parameter] public EventCallback<TaskItem> OnTaskDragStart { get; set; }

    private async Task HandleDrop(DragEventArgs e)
    {
        if (OnDrop.HasDelegate)
        {
            await OnDrop.InvokeAsync();
        }
    }

    private async Task HandleDragOver(DragEventArgs e)
    {
        if (OnDragOver.HasDelegate)
        {
            await OnDragOver.InvokeAsync(e);
        }
    }

    private async Task HandleDragLeave(DragEventArgs e)
    {
        if (OnDragLeave.HasDelegate)
        {
            await OnDragLeave.InvokeAsync(e);
        }
    }

    private async Task HandleTaskClick(TaskItem task)
    {
        if (OnTaskClick.HasDelegate)
        {
            await OnTaskClick.InvokeAsync(task);
        }
    }

    private async Task HandleTaskEdit(TaskItem task)
    {
        if (OnTaskEdit.HasDelegate)
        {
            await OnTaskEdit.InvokeAsync(task);
        }
    }

    private async Task HandleTaskDelete(TaskItem task)
    {
        if (OnTaskDelete.HasDelegate)
        {
            await OnTaskDelete.InvokeAsync(task);
        }
    }

    private async Task HandleTaskDragStart(TaskItem task)
    {
        if (OnTaskDragStart.HasDelegate)
        {
            await OnTaskDragStart.InvokeAsync(task);
        }
    }

    // Assignee name is provided by parent via GetAssigneeName delegate
}
